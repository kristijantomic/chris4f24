# Local development only. Copy to .env: cp .env.example .env
NODE_ENV=development

# The frontend calls the API on port 3001.
PORT=3001

# Matches the role created in postgres/db/1-db-and-users.sql.
DATABASE_URL=postgres://chris_user:secret_pass2@localhost:5433/filesystem

DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
